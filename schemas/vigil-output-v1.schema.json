{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vigil.dev/schemas/vigil-output-v1.schema.json",
  "title": "Vigil machine output envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command",
    "status",
    "exit_code",
    "started_at",
    "finished_at",
    "duration_ms",
    "warnings",
    "errors",
    "data",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "command": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "status": {
      "enum": [
        "ok",
        "failed",
        "invalid",
        "blocked",
        "dependency_missing",
        "interrupted",
        "mutation_violation",
        "internal_error"
      ]
    },
    "exit_code": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "data": true,
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "exit_code": {
            "const": 0
          }
        },
        "required": [
          "exit_code"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "exit_code": {
            "const": 1
          }
        },
        "required": [
          "exit_code"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "exit_code": {
            "const": 2
          }
        },
        "required": [
          "exit_code"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "invalid"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "exit_code": {
            "const": 3
          }
        },
        "required": [
          "exit_code"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "exit_code": {
            "const": 4
          }
        },
        "required": [
          "exit_code"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "dependency_missing"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "exit_code": {
            "const": 5
          }
        },
        "required": [
          "exit_code"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "interrupted"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "exit_code": {
            "const": 6
          }
        },
        "required": [
          "exit_code"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "mutation_violation"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "exit_code": {
            "const": 7
          }
        },
        "required": [
          "exit_code"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "internal_error"
          }
        }
      }
    }
  ],
  "$defs": {
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^VIGIL_[EW]_[A-Z0-9_]+$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "media_type": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
