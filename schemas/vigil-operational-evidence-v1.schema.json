{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vigil.dev/schemas/vigil-operational-evidence-v1.schema.json",
  "title": "Vigil v1 operational evidence report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "repository",
    "tag",
    "version",
    "acceptance_ledger",
    "criteria"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "tag": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "tap_repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "plugin_index_url": {
      "$ref": "#/$defs/https_url"
    },
    "acceptance_ledger": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "release": {
      "$ref": "#/$defs/release"
    },
    "workflow_run": {
      "$ref": "#/$defs/workflow_run"
    },
    "plugin_index": {
      "$ref": "#/$defs/plugin_index"
    },
    "downloaded_assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/downloaded_asset"
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/criterion"
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "notes": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "criteria": {
            "contains": {
              "$ref": "#/$defs/verified_ac09"
            }
          }
        }
      },
      "then": {
        "required": [
          "release",
          "workflow_run"
        ],
        "properties": {
          "release": {
            "required": [
              "resolved_commit",
              "published_at"
            ]
          },
          "workflow_run": {
            "properties": {
              "jobs": {
                "items": {
                  "required": [
                    "url"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "criteria": {
            "contains": {
              "$ref": "#/$defs/verified_ac11"
            }
          }
        }
      },
      "then": {
        "required": [
          "release",
          "downloaded_assets"
        ],
        "properties": {
          "release": {
            "required": [
              "resolved_commit",
              "published_at"
            ],
            "properties": {
              "assets": {
                "items": {
                  "required": [
                    "url"
                  ]
                }
              }
            }
          },
          "downloaded_assets": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "criteria": {
            "contains": {
              "$ref": "#/$defs/verified_ac12"
            }
          }
        }
      },
      "then": {
        "required": [
          "release",
          "workflow_run",
          "tap_repository"
        ],
        "properties": {
          "tag": {
            "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:\\+[0-9A-Za-z.-]+)?$"
          },
          "version": {
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:\\+[0-9A-Za-z.-]+)?$"
          },
          "release": {
            "required": [
              "resolved_commit",
              "published_at"
            ]
          },
          "workflow_run": {
            "properties": {
              "jobs": {
                "items": {
                  "required": [
                    "url"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "criteria": {
            "contains": {
              "$ref": "#/$defs/verified_ac13"
            }
          }
        }
      },
      "then": {
        "required": [
          "release",
          "workflow_run"
        ],
        "properties": {
          "release": {
            "required": [
              "resolved_commit",
              "published_at"
            ],
            "properties": {
              "assets": {
                "items": {
                  "required": [
                    "url"
                  ]
                }
              }
            }
          },
          "workflow_run": {
            "properties": {
              "jobs": {
                "items": {
                  "required": [
                    "url"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "criteria": {
            "contains": {
              "$ref": "#/$defs/verified_ac18"
            }
          }
        }
      },
      "then": {
        "required": [
          "plugin_index_url",
          "plugin_index"
        ],
        "properties": {
          "plugin_index": {
            "required": [
              "ceremony_url",
              "publisher_keys"
            ],
            "properties": {
              "signature_threshold": {
                "minimum": 2
              },
              "ceremony_url": {
                "$ref": "#/$defs/https_url"
              },
              "signer_ids": {
                "minItems": 2
              },
              "publisher_keys": {
                "minItems": 2
              },
              "plugin_count": {
                "minimum": 1
              },
              "artifact_count": {
                "minimum": 1
              },
              "artifacts_verified": {
                "const": true
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "criterion_id": {
      "type": "string",
      "pattern": "^VIGIL-(SI|AC)-[0-9]{2}$"
    },
    "verified_ac09": {
      "$ref": "#/$defs/verified_criterion_VIGIL-AC-09"
    },
    "verified_ac11": {
      "$ref": "#/$defs/verified_criterion_VIGIL-AC-11"
    },
    "verified_ac12": {
      "$ref": "#/$defs/verified_criterion_VIGIL-AC-12"
    },
    "verified_ac13": {
      "$ref": "#/$defs/verified_criterion_VIGIL-AC-13"
    },
    "verified_ac18": {
      "$ref": "#/$defs/verified_criterion_VIGIL-AC-18"
    },
    "verified_criterion_VIGIL-AC-09": {
      "$ref": "#/$defs/verified_criterion",
      "properties": {
        "id": {
          "const": "VIGIL-AC-09"
        }
      }
    },
    "verified_criterion_VIGIL-AC-11": {
      "$ref": "#/$defs/verified_criterion",
      "properties": {
        "id": {
          "const": "VIGIL-AC-11"
        }
      }
    },
    "verified_criterion_VIGIL-AC-12": {
      "$ref": "#/$defs/verified_criterion",
      "properties": {
        "id": {
          "const": "VIGIL-AC-12"
        }
      }
    },
    "verified_criterion_VIGIL-AC-13": {
      "$ref": "#/$defs/verified_criterion",
      "properties": {
        "id": {
          "const": "VIGIL-AC-13"
        }
      }
    },
    "verified_criterion_VIGIL-AC-18": {
      "$ref": "#/$defs/verified_criterion",
      "properties": {
        "id": {
          "const": "VIGIL-AC-18"
        }
      }
    },
    "verified_criterion": {
      "type": "object",
      "required": [
        "id",
        "status"
      ],
      "properties": {
        "status": {
          "const": "verified"
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "https_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/?@#]+(?:[/?][^#]*)?$"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag_name",
        "target_commitish",
        "url",
        "is_draft",
        "is_prerelease",
        "is_immutable",
        "assets"
      ],
      "properties": {
        "tag_name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "target_commitish": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "resolved_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "url": {
          "$ref": "#/$defs/https_url"
        },
        "is_draft": {
          "type": "boolean"
        },
        "is_prerelease": {
          "type": "boolean"
        },
        "is_immutable": {
          "type": "boolean"
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/release_asset"
          }
        }
      }
    },
    "release_asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "url": {
          "$ref": "#/$defs/https_url"
        }
      }
    },
    "workflow_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "database_id",
        "url",
        "status",
        "conclusion",
        "head_sha",
        "jobs"
      ],
      "properties": {
        "database_id": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "$ref": "#/$defs/https_url"
        },
        "status": {
          "enum": [
            "completed",
            "in_progress"
          ]
        },
        "conclusion": {
          "type": "string"
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "jobs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/job"
          }
        }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "conclusion"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "conclusion": {
          "type": "string"
        },
        "url": {
          "$ref": "#/$defs/https_url"
        }
      }
    },
    "plugin_index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "index_digest",
        "signature_threshold",
        "signer_ids",
        "plugin_count",
        "artifact_count",
        "artifacts_verified"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/https_url"
        },
        "index_digest": {
          "$ref": "#/$defs/digest"
        },
        "ceremony_url": {
          "$ref": "#/$defs/https_url"
        },
        "signature_threshold": {
          "type": "integer",
          "minimum": 1
        },
        "signer_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/digest"
          },
          "uniqueItems": true
        },
        "publisher_keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/publisher_key"
          },
          "uniqueItems": true
        },
        "plugin_count": {
          "type": "integer",
          "minimum": 0
        },
        "artifact_count": {
          "type": "integer",
          "minimum": 0
        },
        "artifacts_verified": {
          "type": "boolean"
        }
      }
    },
    "publisher_key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_id",
        "algorithm",
        "source"
      ],
      "properties": {
        "key_id": {
          "$ref": "#/$defs/digest"
        },
        "algorithm": {
          "const": "ed25519"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "downloaded_asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256",
        "size"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "detail"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/criterion_id"
        },
        "status": {
          "enum": [
            "verified",
            "failed",
            "pending",
            "operational_pending",
            "external_pending"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/https_url"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "verified"
              }
            }
          },
          "then": {
            "required": [
              "evidence"
            ],
            "properties": {
              "id": {
                "enum": [
                  "VIGIL-AC-09",
                  "VIGIL-AC-11",
                  "VIGIL-AC-12",
                  "VIGIL-AC-13",
                  "VIGIL-AC-18"
                ]
              }
            }
          }
        }
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "command",
        "exit_code",
        "duration_millis"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "exit_code": {
          "type": "integer",
          "minimum": 0
        },
        "duration_millis": {
          "type": "integer",
          "minimum": 0
        },
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        }
      }
    }
  }
}
