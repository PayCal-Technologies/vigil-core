{
  "schema_version": "2",
  "profile": "go-tool",
  "project": "example-vigil-project",
  "coordination": {
    "mode": "github-adjacent-helper",
    "authoritative_surfaces": [
      "GitHub",
      "reviewed repository configuration",
      "active workflow files"
    ],
    "mutation_requires": [
      "explicit-confirmation",
      "clean-config"
    ]
  },
  "gates": [
    {
      "name": "go test",
      "command": "go test ./...",
      "read_only": true,
      "tags": [
        "test",
        "pre-push"
      ]
    },
    {
      "name": "vigil verify",
      "command": "vigil verify --json",
      "read_only": true,
      "tags": [
        "vigil",
        "pre-commit"
      ]
    }
  ],
  "extensions": {
    "enabled": true,
    "manifest_root": "extensions",
    "allowed_kinds": [
      "custom"
    ],
    "enabled_ids": [
      "scribe",
      "repo-health",
      "github-cicd"
    ],
    "disabled_ids": [],
    "require_private": false
  }
}
