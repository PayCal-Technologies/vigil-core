{
  "schema_version": "3",
  "profile": "go-tool",
  "project": "example-vigil-project",
  "coordination": {
    "mode": "policy-aware-preflight",
    "authoritative_surfaces": [
      "GitHub",
      "reviewed repository configuration",
      "active workflow files"
    ],
    "mutation_requires": [
      "explicit-confirmation",
      "clean-config"
    ]
  },
  "gates": [
    {
      "name": "go test",
      "command": "go",
      "args": [
        "test",
        "./..."
      ],
      "read_only": true,
      "tags": [
        "test",
        "pre-push"
      ]
    },
    {
      "name": "vigil verify",
      "command": "vigil",
      "args": [
        "verify",
        "--json"
      ],
      "read_only": true,
      "tags": [
        "vigil",
        "pre-commit"
      ]
    }
  ],
  "extensions": {
    "enabled": true,
    "manifest_root": "extensions",
    "allowed_kinds": [
      "custom"
    ],
    "enabled_ids": [
      "scribe",
      "repo-health",
      "github-cicd"
    ],
    "disabled_ids": [],
    "require_private": false
  },
  "plugins": {
    "mode": "enabled",
    "local": "allow",
    "require_signed": false,
    "min_signature_threshold": 0,
    "allowed_ids": [],
    "denied_ids": [],
    "allowed_publisher_key_ids": [],
    "denied_capabilities": []
  }
}
