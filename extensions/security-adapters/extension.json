{
  "schema_version": "1",
  "host_api_version": "v1",
  "id": "security-adapters",
  "name": "Security Adapter Extension",
  "kind": "custom",
  "status": "public",
  "private": false,
  "public_core": true,
  "description": "Public security adapter commands for local scanners.",
  "source_root": "extensions/security-adapters",
  "packages": [],
  "commands": [
    "security:gitleaks"
  ],
  "command_contracts": [
    {
      "command": "security:gitleaks",
      "access": "read",
      "capabilities": [
        "filesystem:read",
        "process",
        "git:read"
      ],
      "binding": "builtin:security:gitleaks",
      "timeout": "10m0s",
      "stability": "stable",
      "required_tools": [
        "gitleaks"
      ],
      "network": "none",
      "output_formats": [
        "text"
      ],
      "usage": "vigil security:gitleaks [args]",
      "description": "Run local secret scanner.",
      "install_hint": "brew install gitleaks"
    }
  ]
}
