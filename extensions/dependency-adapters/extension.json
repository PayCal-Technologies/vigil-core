{
  "schema_version": "1",
  "host_api_version": "v1",
  "id": "dependency-adapters",
  "name": "Dependency Adapter Extension",
  "kind": "custom",
  "status": "public",
  "private": false,
  "public_core": true,
  "description": "Public dependency inspection and audit adapters for common package managers.",
  "source_root": "extensions/dependency-adapters",
  "packages": [],
  "commands": [
    "checks:dependency-security",
    "deps:why",
    "npm:audit",
    "composer:validate",
    "php:lint",
    "phpstan:analyse",
    "javascript:quality"
  ],
  "command_contracts": [
    {
      "command": "checks:dependency-security",
      "access": "read",
      "capabilities": [
        "filesystem:read",
        "process",
        "git:read",
        "network"
      ],
      "binding": "builtin:checks:dependency-security",
      "timeout": "10m0s",
      "stability": "stable",
      "required_tools": [],
      "network": "optional",
      "output_formats": [
        "text",
        "json"
      ],
      "usage": "vigil checks:dependency-security [--json]",
      "description": "Run public dependency and scanner adapters.",
      "install_hint": "install npm, Composer, or gitleaks depending on project manifests"
    },
    {
      "command": "deps:why",
      "access": "read",
      "capabilities": [
        "filesystem:read",
        "process",
        "network"
      ],
      "binding": "builtin:deps:why",
      "timeout": "10m0s",
      "stability": "stable",
      "required_tools": [],
      "network": "optional",
      "output_formats": [
        "text",
        "json"
      ],
      "usage": "vigil deps:why [--json] <package>",
      "description": "Find package references in supported dependency manifests."
    },
    {
      "command": "npm:audit",
      "access": "read",
      "capabilities": [
        "filesystem:read",
        "process",
        "network"
      ],
      "binding": "builtin:npm:audit",
      "timeout": "10m0s",
      "stability": "stable",
      "required_tools": [
        "npm"
      ],
      "network": "required",
      "output_formats": [
        "text"
      ],
      "usage": "vigil npm:audit [args]",
      "description": "Run npm audit.",
      "install_hint": "install Node.js and npm"
    },
    {
      "command": "composer:validate",
      "access": "read",
      "capabilities": [
        "filesystem:read",
        "process"
      ],
      "binding": "builtin:composer:validate",
      "timeout": "10m0s",
      "stability": "stable",
      "required_tools": [
        "composer"
      ],
      "network": "none",
      "output_formats": [
        "text"
      ],
      "usage": "vigil composer:validate [args]",
      "description": "Run Composer manifest validation.",
      "install_hint": "install Composer"
    },
    {
      "command": "php:lint",
      "access": "read",
      "capabilities": [
        "filesystem:read",
        "process"
      ],
      "binding": "builtin:php:lint",
      "timeout": "10m0s",
      "stability": "stable",
      "required_tools": [
        "php"
      ],
      "network": "none",
      "output_formats": [
        "text",
        "json"
      ],
      "usage": "vigil php:lint [--json]",
      "description": "Run PHP syntax checks.",
      "install_hint": "install PHP"
    },
    {
      "command": "phpstan:analyse",
      "access": "read",
      "capabilities": [
        "filesystem:read",
        "process"
      ],
      "binding": "builtin:phpstan:analyse",
      "timeout": "10m0s",
      "stability": "stable",
      "required_tools": [
        "phpstan"
      ],
      "network": "none",
      "output_formats": [
        "text"
      ],
      "usage": "vigil phpstan:analyse [args]",
      "description": "Run PHPStan analysis.",
      "install_hint": "install PHPStan"
    },
    {
      "command": "javascript:quality",
      "access": "read",
      "capabilities": [
        "filesystem:read",
        "process",
        "network"
      ],
      "binding": "builtin:javascript:quality",
      "timeout": "10m0s",
      "stability": "stable",
      "required_tools": [],
      "network": "optional",
      "output_formats": [
        "text",
        "json"
      ],
      "usage": "vigil javascript:quality [--json]",
      "description": "Run public JavaScript quality adapters.",
      "install_hint": "install Node.js and npm"
    }
  ]
}
