{
  "schema_version": "1",
  "host_api_version": "v1",
  "id": "scribe",
  "name": "Scribe README Extension",
  "kind": "custom",
  "status": "public",
  "private": false,
  "public_core": true,
  "description": "Public README freshness commands backed by a managed local repository snapshot.",
  "source_root": "extensions/scribe",
  "packages": [],
  "commands": [
    "readme:generate",
    "readme:check"
  ],
  "command_contracts": [
    {
      "command": "readme:generate",
      "access": "write",
      "capabilities": [
        "filesystem:read",
        "process",
        "git:read",
        "filesystem:write"
      ],
      "binding": "builtin:readme:generate",
      "timeout": "10m0s",
      "stability": "stable",
      "required_tools": [],
      "network": "none",
      "output_formats": [
        "text",
        "json"
      ],
      "read_only_flags": [
        "--dry-run"
      ],
      "usage": "vigil readme:generate [--dry-run] [--path README.md] [--json]",
      "description": "Generate Scribe managed README block.",
      "examples": [
        "vigil readme:generate --dry-run",
        "vigil readme:generate"
      ]
    },
    {
      "command": "readme:check",
      "access": "read",
      "capabilities": [
        "filesystem:read",
        "process",
        "git:read"
      ],
      "binding": "builtin:readme:check",
      "timeout": "10m0s",
      "stability": "stable",
      "required_tools": [],
      "network": "none",
      "output_formats": [
        "text",
        "json"
      ],
      "usage": "vigil readme:check [--json]",
      "description": "Check Scribe managed README block freshness."
    }
  ]
}
