{
  "schema_version": "1",
  "id": "scribe",
  "name": "Scribe README Extension",
  "kind": "custom",
  "status": "public",
  "private": false,
  "public_core": true,
  "description": "Public README freshness commands backed by a managed local repository snapshot.",
  "source_root": "extensions/scribe",
  "packages": [],
  "commands": [
    "readme:generate",
    "readme:check"
  ],
  "command_contracts": [
    {
      "command": "readme:generate",
      "access": "conditional-write",
      "usage": "vigil readme:generate [--dry-run] [--path README.md]",
      "description": "Generate Scribe managed README block.",
      "examples": [
        "vigil readme:generate --dry-run",
        "vigil readme:generate"
      ]
    },
    {
      "command": "readme:check",
      "access": "r",
      "usage": "vigil readme:check [--json]",
      "description": "Check Scribe managed README block freshness."
    }
  ]
}
