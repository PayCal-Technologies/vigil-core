{
  "schema_version": "1",
  "host_api_version": "v1",
  "id": "github-cicd",
  "name": "GitHub Actions Helper Extension",
  "kind": "custom",
  "status": "public",
  "private": false,
  "public_core": true,
  "description": "Canonical public GitHub Actions extension for running Vigil preflight checks.",
  "source_root": "extensions/github-cicd",
  "packages": [],
  "commands": [
    "github:init-ci"
  ],
  "command_contracts": [
    {
      "command": "github:init-ci",
      "access": "conditional-write",
      "capabilities": [
        "filesystem:read",
        "process",
        "git:read",
        "filesystem:write"
      ],
      "binding": "builtin:github:init-ci",
      "timeout": "10m0s",
      "stability": "stable",
      "required_tools": [],
      "network": "none",
      "output_formats": [
        "text",
        "json"
      ],
      "write_flags": [
        "--write"
      ],
      "usage": "vigil github:init-ci [--write] [--json]",
      "description": "Generate a GitHub Actions workflow from Vigil preflight checks.",
      "examples": [
        "vigil github:init-ci",
        "vigil github:init-ci --write"
      ]
    }
  ]
}
