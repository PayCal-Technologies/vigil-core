{
  "schema_version": "2",
  "profile": "go-tool",
  "project": "vigil-core",
  "coordination": {
    "mode": "github-adjacent-helper",
    "authoritative_surfaces": [
      "GitHub",
      "reviewed repository configuration",
      "active workflow files"
    ],
    "mutation_requires": [
      "explicit-confirmation",
      "clean-config"
    ]
  },
  "gates": [
    {
      "name": "go test",
      "command": "go test ./...",
      "read_only": true,
      "tags": [
        "test",
        "pre-push"
      ]
    },
    {
      "name": "command catalog",
      "command": "./bin/vigil checks:command-catalog --json",
      "read_only": true,
      "tags": [
        "diagnostic",
        "pre-commit",
        "pre-push"
      ]
    },
    {
      "name": "extension manifests",
      "command": "./bin/vigil extensions:doctor --json",
      "read_only": true,
      "tags": [
        "extension",
        "pre-commit",
        "pre-push"
      ]
    },
    {
      "name": "public assumptions",
      "command": "./bin/vigil checks:public-assumptions --json",
      "read_only": true,
      "tags": [
        "public",
        "pre-commit",
        "pre-push"
      ]
    }
  ],
  "extensions": {
    "enabled": true,
    "manifest_root": "extensions",
    "allowed_kinds": [
      "custom"
    ],
    "require_private": false
  },
  "public_assumption_patterns": [
    "/[A-Za-z0-9._-]+/var/www/[A-Za-z0-9._-]+",
    "/Users/[A-Za-z0-9._-]+/",
    "(?i)[A-Za-z0-9._-]+-private",
    "(?i)private-[A-Za-z0-9._-]+",
    "(?i)company-internal",
    "(?i)customer-specific"
  ]
}
