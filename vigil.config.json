{
  "schema_version": "3",
  "profile": "go-tool",
  "project": "vigil-public",
  "coordination": {
    "mode": "policy-aware-preflight",
    "authoritative_surfaces": [
      "GitHub",
      "reviewed repository configuration",
      "active workflow files"
    ],
    "mutation_requires": [
      "explicit-confirmation",
      "clean-config"
    ]
  },
  "gates": [
    {
      "name": "go test",
      "command": "go",
      "args": [
        "test",
        "./..."
      ],
      "read_only": true,
      "tags": [
        "test",
        "pre-push"
      ]
    },
    {
      "name": "command catalog",
      "command": "./bin/vigil",
      "args": [
        "checks:command-catalog",
        "--json"
      ],
      "read_only": true,
      "tags": [
        "diagnostic",
        "pre-commit",
        "pre-push"
      ]
    },
    {
      "name": "extension manifests",
      "command": "./bin/vigil",
      "args": [
        "extensions:doctor",
        "--json"
      ],
      "read_only": true,
      "tags": [
        "extension",
        "pre-commit",
        "pre-push"
      ]
    },
    {
      "name": "public assumptions",
      "command": "./bin/vigil",
      "args": [
        "checks:public-assumptions",
        "--json"
      ],
      "read_only": true,
      "tags": [
        "public",
        "pre-commit",
        "pre-push"
      ]
    }
  ],
  "extensions": {
    "enabled": true,
    "manifest_root": "extensions",
    "allowed_kinds": [
      "custom"
    ],
    "require_private": false
  },
  "plugins": {
    "mode": "enabled",
    "local": "deny",
    "require_signed": true,
    "min_signature_threshold": 2,
    "allowed_ids": [],
    "denied_ids": [],
    "allowed_publisher_key_ids": [],
    "denied_capabilities": [
      "secrets"
    ]
  },
  "public_assumption_patterns": [
    "/[A-Za-z0-9._-]+/var/www/[A-Za-z0-9._-]+",
    "/Users/[A-Za-z0-9._-]+/",
    "(?i)[A-Za-z0-9._]+-private([^A-Za-z0-9._-]|$)",
    "(?i)private-(repo|repository|deploy|deployment|infra|infrastructure|internal|customer)[A-Za-z0-9._-]*",
    "(?i)company-internal",
    "(?i)customer-specific"
  ]
}
